# Copy this file to .env and set values for your environment.
# MONGO_URI is intentionally blank: the server does not choose a database for you.
MONGO_URI=
PORT=5000
# Set at least 32 cryptographically random bytes (commonly 64 hex characters).
# Keep the value in this ignored local file or a deployment secret store.
JWT_SECRET=
# Optional frontend origin, for example:
# CLIENT_URL=https://your-frontend.example.com
